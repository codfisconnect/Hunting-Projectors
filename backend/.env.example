PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection string
DATABASE_URL="postgresql://hunting_user:hunting_secure_pass@localhost:5432/hunting_projectors_db?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Default Admin Credentials for Seed Script (npm run seed:admin)
ADMIN_EMAIL="admin@huntingprojectors.com"
ADMIN_PASSWORD="AdminSecurePassword123!"
ADMIN_NAME="Store Administrator"

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Hunting Projectors <no-reply@huntingprojectors.com>"
ADMIN_NOTIFICATION_EMAIL="orders@huntingprojectors.com"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_system_user_access_token"
WHATSAPP_BUSINESS_NUMBER="+919876543210"

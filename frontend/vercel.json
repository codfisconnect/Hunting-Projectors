{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://test---hunting-projectors-api-ra5e2di26q-as.a.run.app/api/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://test---hunting-projectors-api-ra5e2di26q-as.a.run.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
